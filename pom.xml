<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.ronison</groupId>
  <artifactId>bars4j</artifactId>
  <version>1.2.0</version>
  <name>Bars4J</name>
  <!--
    Coordinates note: releases up to 1.1.0 were published as org.bars4j:bars4j (GitHub Packages
    only). From 1.2.0 the Maven coordinate is io.github.ronison:bars4j — the verified, free
    GitHub namespace on the Maven Central Portal. Java packages and the JPMS module name remain
    org.bars4j.*; only the Maven coordinate changed.
  -->
  <description>Pure-Java barcode generation library: 20 linear (1D) and 4 matrix (2D) formats, rendering to AWT images, standalone SVG documents and embeddable HTML/SVG snippets.</description>
  <url>https://github.com/ronison/bars4j</url>

  <licenses>
    <license>
      <name>GNU Lesser General Public License, Version 2.1 or later</name>
      <url>https://www.gnu.org/licenses/old-licenses/lgpl-2.1.html</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>ronison</id>
      <name>ronison</name>
      <email>ronison@gmail.com</email>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/ronison/bars4j.git</connection>
    <developerConnection>scm:git:git@github.com:ronison/bars4j.git</developerConnection>
    <url>https://github.com/ronison/bars4j</url>
  </scm>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>17</maven.compiler.release>
    <junit.version>5.10.2</junit.version>
    <zxing.version>3.5.3</zxing.version>
    <!-- Default class run by `mvn exec:java`; override with -Dexec.mainClass=... -->
    <exec.mainClass>org.bars4j.demo.QRCodeDemo</exec.mainClass>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- Only for cross-validating the self-contained QRCode implementation. -->
    <dependency>
      <groupId>com.google.zxing</groupId>
      <artifactId>core</artifactId>
      <version>${zxing.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.google.zxing</groupId>
      <artifactId>javase</artifactId>
      <version>${zxing.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
      </plugin>
      <!-- Attach a -sources jar to the build so it can be published as a release asset. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
        <version>3.3.1</version>
        <executions>
          <execution>
            <id>attach-sources</id>
            <goals>
              <goal>jar-no-fork</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <!-- `mvn verify` runs the automated performance gate (PerformanceIT). -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <version>3.2.5</version>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <systemPropertyVariables>
            <java.awt.headless>true</java.awt.headless>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <!-- `mvn exec:java` runs the demo (default: QRCodeDemo). -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.2.0</version>
        <configuration>
          <mainClass>${exec.mainClass}</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <distributionManagement>
    <repository>
      <id>github</id>
      <name>GitHub Packages</name>
      <url>https://maven.pkg.github.com/ronison/bars4j</url>
    </repository>
  </distributionManagement>

  <!--
    Maven Central publishing (Central Portal). Everything Central-specific lives in this profile so
    the default build and the GitHub Packages deploy are untouched: run `mvn deploy -Pcentral` with
    the `central` server (Portal user token) in settings.xml. The first release should keep
    autoPublish=false (manual confirmation on https://central.sonatype.com/publishing/deployments);
    afterwards flip it to true for fully automated publishing.
  -->
  <profiles>
    <profile>
      <id>central</id>
      <build>
        <plugins>
          <!-- Central requires a -javadoc jar. -->
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>3.12.0</version>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals>
                  <goal>jar</goal>
                </goals>
              </execution>
            </executions>
            <configuration>
              <!-- Do not block publishing on javadoc lint warnings (e.g. missing @param). -->
              <doclint>none</doclint>
              <quiet>true</quiet>
            </configuration>
          </plugin>
          <!-- Central requires GPG signatures for every artifact. -->
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.8</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
              </execution>
            </executions>
            <configuration>
              <!-- Prevent gpg from pinning the terminal prompt in CI. -->
              <gpgArguments>
                <arg>--pinentry-mode</arg>
                <arg>loopback</arg>
              </gpgArguments>
            </configuration>
          </plugin>
          <!-- Bundles the artifacts and uploads them to the Central Portal on `mvn deploy`. -->
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>0.12.0</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <deploymentName>bars4j</deploymentName>
              <autoPublish>false</autoPublish>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
